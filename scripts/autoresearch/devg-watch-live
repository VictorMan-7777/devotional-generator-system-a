#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WATCH_SCRIPT="$SCRIPT_DIR/devg-watch"
INTERVAL="${1:-30}"

# VibeTunnel visibility is inherited from the calling terminal (devg-menu is already
# wrapped with vt). No need to re-wrap — just run watch directly.
if command -v watch >/dev/null 2>&1; then
  exec watch -n "$INTERVAL" -t "$WATCH_SCRIPT"
fi

while true; do
  "$WATCH_SCRIPT"
  printf '\n--- refresh in %ss (Ctrl-C to return) ---\n' "$INTERVAL"
  sleep "$INTERVAL"
done

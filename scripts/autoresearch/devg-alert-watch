#!/bin/bash
set -euo pipefail

REPO_ROOT="${DEVG_REPO_ROOT:-/Volumes/claude-projects/projects/devotional-generator-system-a}"
ACTIVE_LOG="${DEVG_ACTIVE_LOG:-/tmp/devg-active.log}"
INTERVAL="${1:-30}"
STALE_AFTER_SECONDS="${DEVG_STALE_AFTER_SECONDS:-600}"
LIBRARY_REQUEST_SLA_SECONDS="${DEVG_LIBRARY_REQUEST_SLA_SECONDS:-600}"
WORKER_STALE_SECONDS="${DEVG_WORKER_STALE_SECONDS:-600}"
STATE_FILE="${DEVG_ALERT_STATE_FILE:-/tmp/devg-alert-watch.state}"
DB_PATH="${DEVG_REGISTRY_DB:-$REPO_ROOT/registry.db}"

latest_epoch() {
  local latest_output_epoch latest_log_epoch freshest
  latest_output_epoch="$(find "$REPO_ROOT/docs/system/outputs" -maxdepth 1 -type f -print0 2>/dev/null | xargs -0 stat -f '%m' 2>/dev/null | sort -nr | head -1 || true)"
  latest_log_epoch=""
  if [[ -f "$ACTIVE_LOG" ]]; then
    latest_log_epoch="$(stat -f '%m' "$ACTIVE_LOG" 2>/dev/null || true)"
  fi
  freshest=0
  if [[ -n "${latest_output_epoch:-}" ]]; then
    freshest="$latest_output_epoch"
  fi
  if [[ -n "${latest_log_epoch:-}" ]] && [[ "$latest_log_epoch" -gt "$freshest" ]]; then
    freshest="$latest_log_epoch"
  fi
  printf '%s\n' "$freshest"
}

send_notification() {
  local message="$1"
  osascript >/dev/null 2>&1 <<OSA || true
display notification "$(printf '%s' "$message" | sed 's/"/\\"/g')" with title "DevG Alert"
OSA
}

mark_state() {
  printf '%s\n' "$1" > "$STATE_FILE"
}

current_state() {
  if [[ -f "$STATE_FILE" ]]; then
    cat "$STATE_FILE"
  else
    printf 'fresh\n'
  fi
}

oldest_library_request_age() {
  if [[ ! -f "$DB_PATH" ]]; then
    printf '0\n'
    return
  fi
  python3 - "$DB_PATH" <<'PY'
import sqlite3, sys
from datetime import datetime, timezone

db_path = sys.argv[1]
conn = sqlite3.connect(db_path)
row = conn.execute("""
SELECT created_at_utc
FROM resource_acquisition_requests
WHERE requested_by='research_librarian'
  AND status IN ('requested','pending','queued','waiting')
  AND TRIM(COALESCE(created_at_utc, '')) <> ''
ORDER BY created_at_utc ASC
LIMIT 1
""").fetchone()
if not row:
    print(0)
else:
    dt = datetime.fromisoformat(str(row[0]).replace("Z", "+00:00"))
    age = int((datetime.now(timezone.utc) - dt).total_seconds())
    print(age)
PY
}

stale_worker_summary() {
  if [[ ! -f "$DB_PATH" ]]; then
    printf '0|\n'
    return
  fi
  python3 - "$DB_PATH" "$WORKER_STALE_SECONDS" <<'PY'
import sqlite3, sys
from datetime import datetime, timezone

db_path = sys.argv[1]
threshold = int(sys.argv[2])
conn = sqlite3.connect(db_path)
rows = conn.execute("""
SELECT worker_name, MAX(created_at_utc) AS last_updated_utc
FROM autoresearch_experiments
WHERE NOT (worker_name = 'outliner' AND benchmark_reference IN ('genesis-1-2','job-1-3','matthew-1-2','psalms-1-3','ezekiel-37','ezekiel-38-39','genesis-12-13','exodus-19-20','proverbs-1-2','psalms-23-25','luke-15','acts-9'))
  AND worker_name NOT IN ('acquisition_librarian','research_librarian')
  AND TRIM(COALESCE(created_at_utc, '')) <> ''
GROUP BY worker_name
ORDER BY worker_name
""").fetchall()
now = datetime.now(timezone.utc)
stale = []
for worker_name, last_updated_utc in rows:
    if not last_updated_utc:
        continue
    dt = datetime.fromisoformat(str(last_updated_utc).replace("Z", "+00:00"))
    if (now - dt).total_seconds() >= threshold:
        stale.append(worker_name)
print(f"{len(stale)}|{', '.join(stale)}")
PY
}

mkdir -p "$(dirname "$STATE_FILE")" "$(dirname "$ACTIVE_LOG")"

while true; do
  now_epoch="$(date +%s)"
  freshest_epoch="$(latest_epoch)"
  state="$(current_state)"
  if [[ "$freshest_epoch" -gt 0 ]]; then
    age=$((now_epoch - freshest_epoch))
    library_age="$(oldest_library_request_age)"
    worker_summary="$(stale_worker_summary)"
    worker_stale_count="${worker_summary%%|*}"
    worker_stale_names="${worker_summary#*|}"
    if [[ "$age" -ge "$STALE_AFTER_SECONDS" ]]; then
      if [[ "$state" != "stale" ]]; then
        msg="DevG monitor is stale (${age}s since last log/artifact change). Check the active process."
        printf 'ALERT %s :: %s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')" "$msg" >> "$ACTIVE_LOG"
        send_notification "$msg"
        mark_state "stale"
      fi
    elif [[ "${library_age:-0}" -ge "$LIBRARY_REQUEST_SLA_SECONDS" ]]; then
      if [[ "$state" != "library_stale" ]]; then
        msg="Library turnaround is overdue (${library_age}s on oldest research-librarian request). Check librarian handoff."
        printf 'ALERT %s :: %s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')" "$msg" >> "$ACTIVE_LOG"
        send_notification "$msg"
        mark_state "library_stale"
      fi
    elif [[ "${worker_stale_count:-0}" -gt 0 ]]; then
      if [[ "$state" != "worker_stale" ]]; then
        msg="Worker training is stale for: ${worker_stale_names}. Check whether new cycles need to start."
        printf 'ALERT %s :: %s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')" "$msg" >> "$ACTIVE_LOG"
        send_notification "$msg"
        mark_state "worker_stale"
      fi
    else
      if [[ "$state" != "fresh" ]]; then
        msg="DevG monitor is active again (${age}s since last change)."
        printf 'RECOVERY %s :: %s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')" "$msg" >> "$ACTIVE_LOG"
        send_notification "$msg"
        mark_state "fresh"
      fi
    fi
  fi
  sleep "$INTERVAL"
done

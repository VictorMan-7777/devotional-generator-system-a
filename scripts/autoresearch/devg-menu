#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WATCH_LIVE="$SCRIPT_DIR/devg-watch-live"
ALERT_WATCH="$SCRIPT_DIR/devg-alert-watch"
CURRENT_HOLDINGS="$SCRIPT_DIR/devg-current-holdings"

clear_like_cmd_k() {
  printf '\033[3J\033[H\033[2J'
  printf '\033]1337;ClearScrollback\a' 2>/dev/null || true
}

run_item() {
  local label="$1"
  shift
  clear_like_cmd_k
  echo "Starting: $label"
  echo "Press Ctrl-C to stop and return to the menu."
  echo
  "$@" || true
}

while true; do
  clear_like_cmd_k
  cat <<EOF
DevG Menu
=========
1. Live Monitor (foreground)
2. Alert Watcher
3. Current Holdings
0. Quit
EOF
  printf '\nChoose an option: '
  read -r choice

  case "$choice" in
    1)
      run_item "Live Monitor" env DEVG_NO_CLEAR=1 "$WATCH_LIVE"
      ;;
    2)
      run_item "Alert Watcher" "$ALERT_WATCH"
      ;;
    3)
      run_item "Current Holdings" "$CURRENT_HOLDINGS"
      ;;
    0|q|Q|quit|exit)
      clear_like_cmd_k
      exit 0
      ;;
    *)
      echo
      echo "Unknown option: $choice"
      printf '\nPress Enter to return to the menu...'
      read -r _
      ;;
  esac
done
